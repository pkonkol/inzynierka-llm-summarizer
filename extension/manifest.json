{
  "manifest_version": 3,
  "name": "Podsumowania",
  "version": "0.2.0",
  "description": "Podsumuj bieżącą stronę albo link w panelu bocznym.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Otwórz panel Podsumowań"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "contextMenus"],
  "host_permissions": ["<all_urls>"]
}
