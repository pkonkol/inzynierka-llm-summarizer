{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -b --noEmit",
    "print-types": "openapi-typescript ../backend/openapi.json --root-types --root-types-no-schema-prefix",
    "generate-types": "npm run -s print-types > src/types/api.generated.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3",
    "loglevel": "^1.9",
    "react": "^19.3",
    "react-dom": "^19.3",
    "react-markdown": "^10.1",
    "remark-gfm": "^4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@tailwindcss/vite": "^4.3",
    "@types/node": "^24.19",
    "@types/react": "^19.3",
    "@types/react-dom": "^19.3",
    "@vitejs/plugin-react": "^6.2",
    "openapi-typescript": "^7.13",
    "tailwindcss": "^4.3",
    "typescript": "~6.0",
    "vite": "^8.3"
  }
}
