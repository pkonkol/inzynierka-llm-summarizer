{
    // "python-envs.defaultEnvManager": "ms-python.python:venv",
    "python.analysis.autoFormatStrings": true,
    "python-envs.workspaceSearchPaths": [
        ".venv",
        "*/.venv",
        "backend/venv",
        "backend/.venv"
    ],
    "python.envFile": "${workspaceFolder}/backend/.env",
    "python-envs.defaultEnvManager": "ms-python.python:venv",
    // "python.defaultInterpreterPath": "${workspaceFolder}/backend/venv/bin/activate",

    // Pylance is pyright; type checking belongs to pyrefly (see justfile). Running both would
    // mean two suppression syntaxes for the same code. Pylance keeps completion and hover.
    "python.analysis.typeCheckingMode": "off",

    // Pinned per language so the editor never has to guess which formatter owns a file.
    "editor.formatOnSave": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
    "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
    "[json]": { "editor.defaultFormatter": "biomejs.biome" },
    "[jsonc]": { "editor.defaultFormatter": "biomejs.biome" }
}
