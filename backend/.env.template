# LLM providers
GEMINI_API_KEY=your-gemini-key-here
OPENROUTER_API_KEY=your-openrouter-key-here

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=web_summarization
MONGODB_JOBS_COLLECTION=jobs

# Auth
AUTH_SECRET=change-me
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=168

# Supported models - musi byc jako jedna linia JSON (pydantic-settings nie obsluguje multiline).
# Edytuj infra/supported_models.json (multiline), potem wgraj do GCP Secret Manager.
# Do lokalnego developmentu skopiuj ponizej zminifikowany JSON:
SUPPORTED_MODELS={"gemini":["gemini-2.5-flash-lite","gemini-2.5-pro"],"openrouter":["google/gemma-4-31b-it:free"]}
