{
	"folders": [
		{
			"path": "."
		},
		{
			"path": "../inzynierka-tmp"
		}
	],
	"settings": {
		"python.analysis.autoFormatStrings": true,
		"python-envs.defaultEnvManager": "ms-python.python:venv",
		"python-envs.workspaceSearchPaths": [
			".venv",
			"*/.venv",
			"backend/venv",
			"backend/.venv"
		],
		"python.envFile": "${workspaceFolder}/backend/.env",
		"python.analysis.typeCheckingMode": "off",
		"chat.tools.terminal.autoApprove": {
			"git check-ignore": true,
			"git init": true,
			"git add": true,
			"mongosh": true
		},
		"editor.formatOnSave": true,
		"[python]": {
			"editor.defaultFormatter": "charliermarsh.ruff",
			"editor.codeActionsOnSave": {
				"source.fixAll.ruff": "explicit",
				"source.organizeImports.ruff": "explicit"
			}
		},
		"[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
		"[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
		"[json]": { "editor.defaultFormatter": "biomejs.biome" },
		"[jsonc]": { "editor.defaultFormatter": "biomejs.biome" },
		"workbench.colorCustomizations": {
			"activityBar.activeBackground": "#002467",
			"activityBar.activeBorder": "#e7e7e7",
			"activityBar.background": "#002467",
			"activityBar.foreground": "#e7e7e7",
			"activityBar.inactiveForeground": "#e7e7e799",
			"activityBarBadge.background": "#bf0043",
			"activityBarBadge.foreground": "#e7e7e7",
			"activityBarTop.activeBackground": "#002467",
			"activityBarTop.activeBorder": "#e7e7e7",
			"activityBarTop.background": "#002467",
			"activityBarTop.foreground": "#e7e7e7",
			"activityBarTop.inactiveForeground": "#e7e7e799",
			"commandCenter.border": "#e7e7e799",
			"commandCenter.foreground": "#e7e7e7",
			"sash.hoverBorder": "#002467",
			"statusBar.background": "#001234",
			"statusBar.debuggingBackground": "#001234",
			"statusBar.debuggingForeground": "#e7e7e7",
			"statusBar.foreground": "#e7e7e7",
			"statusBarItem.hoverBackground": "#002467",
			"statusBarItem.remoteBackground": "#9f0037",
			"statusBarItem.remoteForeground": "#e7e7e7",
			"titleBar.activeBackground": "#001234",
			"titleBar.activeForeground": "#e7e7e7",
			"titleBar.inactiveBackground": "#00123499",
			"titleBar.inactiveForeground": "#e7e7e799",
			"statusBar.inactiveBackground": "#001234"
		},
		"peacock.color": "#001234",
		// settings.json
		"workbench.tree.enableStickyScroll": true, // nagłówek folderu zostaje u góry przy przewijaniu stu plików
		"workbench.tree.indent": 16, // wyraźniejsze wcięcia
		"workbench.tree.renderIndentGuides": "always",
		"explorer.compactFolders": false, // bez sklejania a/b/c w jeden wiersz
		"explorer.fileNesting.enabled": true, // powiązane pliki zwinięte pod rodzicem
		"explorer.fileNesting.patterns": {
			"*.tsx": "${capture}.test.tsx, ${capture}.module.css"
		},
		"workbench.list.defaultFindMode": "filter", // niepasujące pliki znikają z drzewa
		"workbench.list.defaultFindMatchType": "fuzzy", // "evrun" trafia w evaluation_runner.py
		"files.exclude": {
			"**/__pycache__": true,
			"**/.pytest_cache": true,
			"**/.ruff_cache": true,
			"**/node_modules": true,
			"**/venv": true,
			"**/.terraform": true,
			"**/.codegraph": true,
			"**/.claude": true,
			"**/.git": true,
			"**/.deepeval": true,
			"**/.aider*": true,
			"**/.githooks": true
		}
	}
}
