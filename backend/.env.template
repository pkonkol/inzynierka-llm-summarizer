# LLM providers
GEMINI_API_KEY=your-gemini-key-here
OPENROUTER_API_KEY=your-openrouter-key-here

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=web_summarization
MONGODB_JOBS_COLLECTION=jobs

# Auth
# AUTH_ENABLED=true requires both secrets below; the app refuses to start without them.
AUTH_ENABLED=false
AUTH_SECRET=change-me
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=168

# "pretty" for local colored output, "json" for GCP Cloud Logging.
LOG_FORMAT=pretty

# Browser origins allowed by CORS, as one JSON line (same convention as SUPPORTED_MODELS).
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Supported models - musi byc jako jedna linia JSON (pydantic-settings nie obsluguje multiline).
# Edytuj infra/supported_models.json (multiline), potem wgraj do GCP Secret Manager.
# Do lokalnego developmentu skopiuj ponizej zminifikowany JSON:
SUPPORTED_MODELS={"gemini":["gemini-2.5-flash-lite","gemini-2.5-pro"],"openrouter":["google/gemma-4-31b-it:free"]}
