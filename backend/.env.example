# LLM providers
GEMINI_API_KEY=your-gemini-key-here
OPENROUTER_API_KEY=your-openrouter-key-here
# Only needed for the ollama provider.
OLLAMA_URL=http://localhost:11434
# Ollama models allowed to think, as one JSON line; every other Ollama model runs with reasoning off.
# gpt-oss takes only reasoning levels and keeps thinking with reasoning off, whatever this list says.
OLLAMA_THINKING_MODELS=[]

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=web_summarization
MONGODB_JOBS_COLLECTION=jobs

# Auth
# AUTH_ENABLED=true requires both secrets below; the app refuses to start without them.
AUTH_ENABLED=false
AUTH_SECRET=change-me
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=168

# "pretty" for local colored output, "json" for GCP Cloud Logging.
LOG_FORMAT=pretty
# true logs every pipeline step, prompts and model output included.
DEBUG=false

# Browser origins allowed by CORS, as one JSON line (same convention as SUPPORTED_MODELS).
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# One JSON line (pydantic-settings cannot read multiline values). The readable source is
# infra/supported_models.json (Secret Manager) or infra/supported_models_local.json (adds Ollama); paste it minified.
SUPPORTED_MODELS={"gemini":["gemini-3.8-flash","gemma-4-31b-it"],"openrouter":["deepseek/deepseek-v4.1-flash-1017","deepseek/deepseek-v4-pro-0813","deepseek/deepseek-v3.2","qwen/qwen3.8-flash","qwen/qwen3.8-27b","qwen/qwen3.5-27b","qwen/qwen3.5-9b","openai/gpt-oss-20b","google/gemma-4-26b-a4b-it","ibm-granite/granite-4.2-8b","google/gemma-3-4b-it","mistralai/ministral-3b-2512","liquid/lfm-2.5-2.6b","nvidia/nemotron-3.5-lightning:free","nvidia/nemotron-3-ultra-550b-a55b:free","openai/gpt-oss-120b","openai/gpt-5.6-luna","openai/gpt-5.6-terra","qwen/qwen3.8-max-0902","xiaomi/mimo-v2.5","inclusionai/ling-3.0-flash","upstage/solar-pro4"],"ollama":["qwen3.8:27b","qwen3.5:0.8b","qwen3.5:2b","qwen3.5:4b","gpt-oss:20b","gemma4-26b-a4b-hauhau:latest"]}
